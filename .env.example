# 백엔드 API 주소 — 서버(Next) 쪽에서만 쓴다. 같은 compose 망이면 http://backend:8080, 아니면 운영 API.
BOOKEY_API_URL=https://api.bookey.site
# 이 사이트의 공개 주소 — 메타데이터(canonical·OG)·사이트맵에 쓴다.
SITE_URL=https://www.bookey.site
# 앱 스토어 링크 — 비어 있으면 '곧 출시' 안내를 보여 준다. 값이 생기면 컨테이너 재시작만으로 반영된다(빌드에 박히지 않는다).
APP_STORE_URL=
PLAY_STORE_URL=
# App Store 숫자 ID — 있으면 iOS Safari 스마트 배너(apple-itunes-app) 메타를 단다.
APP_STORE_ID=
# 문의 메일 주소
SUPPORT_EMAIL=support@bookey.site
